# Azure AD app registration (Microsoft Graph, application permissions)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The mailbox that receives the Eastman operations emails (UPN or shared mailbox address)
MAILBOX_USER=ops-eastman@yourcompany.com

# Subject text that identifies a relevant email (case-insensitive substring match)
SUBJECT_KEYWORD=NEW EASTMAN CHEMICAL DOCUMENT

# How far back to look on the very first run (days). Later runs use the state file instead.
POLL_LOOKBACK_DAYS=7

# One-time seed: your current shared "Incoming vessels" workbook. On first run this is
# copied to TRACKER_XLSX_PATH and is never opened or modified again.
TRACKER_SEED_XLSX=./data/EASTMAN_ORDER_STATUS_seed.xlsx

# The working copy this automation owns and appends to. Never the shared team file.
TRACKER_XLSX_PATH=./data/EASTMAN_ORDER_STATUS_tracker.xlsx

# Sheet name to append rows to inside the tracker workbook. {year} is substituted.
TRACKER_SHEET_NAME=Incoming vessels-{year}

# Where processed message IDs are recorded, so re-runs never duplicate rows.
STATE_FILE=./data/processed_messages.json

LOG_LEVEL=INFO
